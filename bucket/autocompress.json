    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/guyu-guyu/AutoVideoCompressor/releases/download/v0.1.0/AutoCompress_0.1.0.exe",
            "hash": "7223aa6af95ab80c3852493fcffb0b8ad1194495e805b111bafea2cce5a3422e"
        }
    },
