{
    "version": "1.0.62",
    "description": "现代 Windows 文件管理器 — 多窗格工作区、索引与拼音搜索、丰富预览、标签和批量重命名",
    "homepage": "https://github.com/jimmgreen/pulse",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/jimmgreen/pulse/releases/download/v1.0.62/PulseSetup-1.0.62.exe",
            "hash": "951b5d2a88418965638189da08a2d8fb17e53fc5a5298f4be8e5e49ed1a9e117"
        }
    },
    "installer": {
        "script": [
            "$shell = New-Object -ComObject WScript.Shell",
            "$shortcut = $shell.CreateShortcut((Join-Path $dir 'Pulse.lnk'))",
            "$shortcut.TargetPath = Join-Path $dir 'pulse.exe'",
            "$shortcut.WorkingDirectory = $dir",
            "$shortcut.IconLocation = Join-Path $dir 'pulse.exe'",
            "$shortcut.Save()"
        ],
        "args": [
            "/VERYSILENT",
            "/SUPPRESSMSGBOXES",
            "/NORESTART",
            "/SP-",
            "/DIR=\"$dir\"",
            "/TASKS=!indexservice,globalsearch,aiassistant,!startup,!desktopicon"
        ]
    },
    "uninstaller": {
        "file": "uninstall.exe",
        "args": [
            "/VERYSILENT",
            "/SUPPRESSMSGBOXES",
            "/NORESTART",
            "/SP-"
        ]
    },
    "bin": "pulse.exe",
    "shortcuts": [
        [
            "Pulse.lnk",
            "Pulse"
        ]
    ],
    "checkver": {
        "github": "https://github.com/jimmgreen/pulse"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/jimmgreen/pulse/releases/download/v$version/PulseSetup-$version.exe"
            }
        }
    }
}
